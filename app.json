{
  "expo": {
    "name": "Поехали",
    "slug": "poekhali-georgia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.poekhali.georgia"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F4F3A"
      },
      "predictiveBackGestureEnabled": true,
      "package": "dev.poekhali.georgia"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Поехали — поездки по Грузии"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "scheme": "poekhali"
  }
}
